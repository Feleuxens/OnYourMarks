      }
    },
    "Frame rate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildrate"
          }
        }
      }
    },
    "Go to the gun" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Schuss springen"
          }
        }
      }
    },
    "Handheld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus der Hand"
          }
        }
      }
    },
    "Handheld compensates for small movements of the camera. A tripod is more precise. A higher frame rate times a movement more finely but needs more light; if the camera doesn't reach it, its fastest rate is used. A recorded start can be reviewed frame by frame afterwards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aus der Hand“ gleicht kleine Bewegungen der Kamera aus. Mit Stativ ist die Messung genauer. Eine höhere Bildrate misst eine Bewegung feiner, braucht aber mehr Licht; erreicht die Kamera sie nicht, wird ihre schnellste Rate verwendet. Einen aufgenommenen Start kannst du danach Bild für Bild ansehen."
          }
        }
      }
    },
    "iPhone speaker" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-Lautsprecher"
          }
