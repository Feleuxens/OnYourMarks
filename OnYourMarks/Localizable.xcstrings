{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "%@ is wireless and isn't calibrated, so false-start detection will be inaccurate. Use the iPhone speaker or a wired speaker, or calibrate it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kabellos und nicht kalibriert, deshalb wird die Fehlstarterkennung ungenau. Nutze den iPhone-Lautsprecher oder einen Lautsprecher mit Kabel, oder kalibriere die Ausgabe in den Einstellungen."
          }
        }
      }
    },
    "%@ is wireless. Its delay can change while it plays, so reaction times are less accurate. Use the iPhone speaker or a wired speaker for accurate results." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kabellos. Die Verzögerung kann sich während der Wiedergabe ändern, deshalb sind die Reaktionszeiten ungenauer. Nutze für genaue Ergebnisse den iPhone-Lautsprecher oder einen Lautsprecher mit Kabel."
          }
        }
      }
    },
    "%@ · %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@"
          }
        }
      }
    },
