    },
    "False start: athletes %@ from the left" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlstart: Athleten %@ von links"
          }
        }
      }
    },
    "Frame %lld of %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bild %1$lld von %2$lld"
          }
