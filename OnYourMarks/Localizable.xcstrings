          }
        }
      }
    },
    "The athletes did not hold still, so the start was cancelled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Athleten standen nicht still, daher wurde der Start abgebrochen."
          }
        }
      }
    },
    "The audio engine could not be started." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audiowiedergabe konnte nicht gestartet werden."
          }
        }
      }
    },
    "The audio output changed during the calibration. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audioausgabe hat sich während der Kalibrierung geändert. Bitte versuch es erneut."
          }
        }
      }
    },
    "The calibration click could not be played: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kalibrierungsklick konnte nicht abgespielt werden: %@"
          }
        }
      }
    },
    "The camera could not be configured." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera konnte nicht konfiguriert werden."
          }
        }
      }
    },
    "The clicks varied by %lld ms. Keep the output still and the room quiet, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Klicks schwankten um %lld ms. Halte die Ausgabe ruhig, sorge für Stille und versuch es erneut."
          }
        }
      }
    },
    "The iPhone speaker and calibration need microphone access. You can allow it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iPhone-Lautsprecher und die Kalibrierung brauchen Mikrofonzugriff. Du kannst ihn in den Einstellungen erlauben."
          }
        }
      }
    },
    "The iPhone speaker could not be selected; the signals would play on %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iPhone-Lautsprecher konnte nicht ausgewählt werden; die Signale würden über %@ abgespielt."
          }
        }
      }
    },
    "The iPhone speaker reports its latency precisely, so it needs no calibration." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iPhone-Lautsprecher meldet seine Latenz genau und braucht daher keine Kalibrierung."
          }
        }
      }
    },
    "The microphone could not record: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon konnte nicht aufnehmen: %@"
          }
        }
      }
    },
    "The microphone only heard %lld of %lld needed clicks. Turn the volume up and hold the output close to the iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon hat nur %lld von %lld nötigen Klicks gehört. Stell die Lautstärke hoch und halte die Ausgabe näher ans iPhone."
          }
        }
      }
    },
    "The next start replaces it unless you save it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der nächste Start ersetzt ihn, wenn du ihn nicht sicherst."
          }
        }
      }
    },
    "The start could not be prepared: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Start konnte nicht vorbereitet werden: %@"
          }
        }
      }
    },
    "The start could not be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Start konnte nicht gesichert werden."
          }
        }
      }
    },
    "The start signal could not be played." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Startsignal konnte nicht abgespielt werden."
          }
        }
      }
    },
    "The start was aborted because the audio output changed (now: %@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Start wurde abgebrochen, weil sich die Audioausgabe geändert hat (jetzt: %@)."
          }
        }
      }
    },
    "The start was aborted because the audio system was reconfigured." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Start wurde abgebrochen, weil das Audiosystem neu konfiguriert wurde."
          }
        }
      }
    },
    "The start was aborted because the audio system was reset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Start wurde abgebrochen, weil das Audiosystem zurückgesetzt wurde."
          }
        }
      }
    },
    "The start was aborted because the system deactivated audio (e.g. a call or an alarm)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Start wurde abgebrochen, weil das System die Audiowiedergabe beendet hat (z. B. durch einen Anruf oder Wecker)."
          }
        }
      }
    },
    "The system did not activate the audio session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System hat die Audiositzung nicht aktiviert."
          }
        }
      }
    },
    "Time until \"On Your Marks\"" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit bis „On Your Marks“"
          }
        }
      }
    },
    "Time until \"Set\"" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit bis „Set“"
          }
        }
      }
    },
    "Tripod" : {
      "localizations" : {
