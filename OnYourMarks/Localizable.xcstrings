{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "%@ isn't calibrated, so false-start detection will be inaccurate. Calibrate it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht kalibriert, daher wird die Fehlstarterkennung ungenau. Kalibriere die Ausgabe in den Einstellungen."
          }
        }
      }
    },
    "%lld ms ± %lld ms" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ms ± %lld ms"
          }
        }
      }
    },
    "A start sound could not be loaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Startsignal konnte nicht geladen werden."
