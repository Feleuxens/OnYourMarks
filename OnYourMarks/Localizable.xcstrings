    "Enable camera access in Settings to use false-start detection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Kamerazugriff in den Einstellungen, um Fehlstarts zu erkennen."
