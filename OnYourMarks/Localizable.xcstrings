    },
    "A start with the camera on is recorded and can be reviewed here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Start mit eingeschalteter Kamera wird aufgenommen und kann hier angesehen werden."
