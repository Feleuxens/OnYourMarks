{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "%@ isn't calibrated, so false-start detection will be inaccurate. Calibrate it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht kalibriert, daher wird die Fehlstarterkennung ungenau. Kalibriere die Ausgabe in den Einstellungen."
          }
        }
      }
    },
    "%lld fps" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld fps"
          }
        }
      }
    },
    "%lld ms after the gun" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ms nach dem Schuss"
