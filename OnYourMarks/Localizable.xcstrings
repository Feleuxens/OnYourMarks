        }
      }
    },
    "Calibration plays the start signal six times and listens with the microphone. Turn the volume up and hold the headphones or speaker next to the iPhone, in a quiet room." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kalibrierung spielt das Startsignal sechsmal ab und hört mit dem Mikrofon zu. Stell die Lautstärke hoch und halte Kopfhörer oder Lautsprecher in einem ruhigen Raum neben das iPhone."
          }
        }
      }
    },
    "Camera access required" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerazugriff erforderlich"
          }
        }
      }
    },
